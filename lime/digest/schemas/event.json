{
  "type": "object",
  "additionalProperties": false,
  "required": ["has_event", "events"],
  "properties": {
    "has_event": { "type": "boolean" },
    "events": {
      "type": "array",
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "summary", "when", "confirmed", "needs_action", "quote", "confidence"],
        "properties": {
          "kind": {
            "type": "string",
            "enum": ["plan", "deadline", "money", "travel", "health", "conflict", "request", "other"]
          },
          "summary": { "type": "string" },
          "when": { "type": "string" },
          "confirmed": { "type": "boolean" },
          "needs_action": { "type": "boolean" },
          "quote": { "type": "string" },
          "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
        }
      }
    }
  }
}
