# Copy to backend.tf after the first apply (state still local), then run
#   tofu init -migrate-state
# AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY must be the "state" user's keys.
terraform {
  backend "s3" {
    bucket = "satsuma-tofu-state"
    key    = "homelab.tfstate"
    region = "ca-east-tor"
    endpoints = {
      s3 = "https://s3.ca-east-tor.io.cloud.ovh.net/"
    }
    skip_credentials_validation = true
    skip_region_validation      = true
    skip_requesting_account_id  = true
    skip_s3_checksum            = true
    use_lockfile                = true
  }
}
